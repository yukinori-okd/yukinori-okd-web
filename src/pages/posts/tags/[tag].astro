---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import PostLayout from '../../../layouts/PostLayout.astro'; // 適切なレイアウトを指定

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');

  // 1. 全記事からユニークなタグを集める
  const uniqueTags = new Set<string>();
  allPosts.forEach((post) => {
    // post.data.tags が存在する場合のみ処理 (?. オプショナルチェイニング)
    post.data.tags?.forEach((tag) => {
      uniqueTags.add(tag); // Setが自動で重複を除外
    });
  });

  // 2. 各タグに対応するページ情報を作成
  return Array.from(uniqueTags).map((tag) => {
    // 3. このタグが含まれる記事だけをフィルタリング
    const filteredPosts = allPosts.filter((post) =>
      post.data.tags?.includes(tag)
    );
    // 4. ページのパスと渡すデータを返す
    return {
      params: { tag: tag }, // URLの [tag] 部分になる値
      props: {
        tag: tag, // ページコンポーネントで使うタグ名
        posts: filteredPosts, // このタグの記事リスト
      },
    };
  });
}

// getStaticPathsから渡されたデータを受け取る
const { tag, posts } = Astro.props;
// 記事を日付順にソート (任意)
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PostLayout title={`タグ: 「${tag}」 の記事一覧`} description="" pubDate={new Date()}>
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-list-item">
        <a href={`/posts/${post.id}/`}>
          <span class="post-title">{post.data.title}</span>
          <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
        </a>
      </li>
    ))}
  </ul>

  <p class="back-link">
    <a href="/posts/tags/">すべてのタグ一覧へ</a>
  </p>
</PostLayout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }
  .post-list-item {
    border: 1px solid rgb(var(--surface-sub));
    border-radius: 8px;
    transition: border-color 0.15s ease;
  }
  .post-list-item:hover {
    border-color: rgb(var(--accent));
  }
  .post-list-item a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
    padding: 0.9em 1.2em;
    text-decoration: none;
    color: rgb(var(--text-primary));
  }
  .post-title {
    font-weight: 700;
  }
  .post-list-item a:hover .post-title {
    color: rgb(var(--accent));
  }
  .post-date {
    flex-shrink: 0;
    font-size: 0.85em;
    color: rgb(var(--text-secondary));
  }
  .back-link {
    margin-top: 2em;
  }
</style>
