---
import PostLayout from "../layouts/PostLayout.astro";
import { loadDefaultJapaneseParser } from "budoux";

const parser = loadDefaultJapaneseParser();

// ここで単語のデータを定義
const words = [
    {
        term: "Astro",
        reading: "アストロ",
        definition:
            "コンテンツ駆動の高速なWebサイトを構築するためのWebフレームワーク。このサイトでも使用している。",
        tags: ["Technology", "Web"],
        references: ["https://astro.build/"],
    },
    {
        term: "TypeScript",
        reading: "タイプスクリプト",
        definition:
            "JavaScriptに静的型付けを追加したプログラミング言語。このサイトでも使用している。",
        tags: ["Language", "Web"],
        references: ["https://www.typescriptlang.org/"],
    },
    {
        term: "Garbage Collection",
        reading: "ガベージコレクション",
        definition:
            "プログラムが動的に確保したメモリ領域のうち、不要になったものを自動的に検索して解放する仕組み。メモリリークを防ぎ、開発者の負担を軽減するが、コレクタの動作によるパフォーマンスの影響がある場合もある。",
        tags: ["Technology"],
        references: [],
    },
    {
        term: "P/Invoke",
        reading: "ピーインボーク",
        definition:
            "Platform Invocation Servicesの略。C#などのマネージドコードから、C/C++などで書かれたネイティブなアンマネージドDLLの関数を呼び出すための機能。",
        tags: ["Technology"],
        references: [
            "https://learn.microsoft.com/ja-jp/dotnet/standard/native-interop/pinvoke",
        ],
    },
    {
        term: "Markdown",
        reading: "マークダウン",
        definition:
            "テキスト形式で記述した文書をHTMLなどに変換するための軽量マークアップ言語。記号を用いて手軽に見出しやリスト、リンクなどを表現できる。Postsページのコンテンツは大体Markdownで書いている。",
        tags: ["Language"],
        references: [],
    },
    {
        term: "TeX",
        reading: "テフ",
        definition:
            "組版処理システム。特に複雑な数式のレイアウトや描画に優れており、理系分野の学術論文などで標準的に用いられる。",
        tags: ["Typography"],
        references: ["https://www.tug.org"],
    },
    {
        term: "Typst",
        reading: "タイプスト",
        definition:
            "Rust製の高速な新しい組版処理システムおよびマークアップ言語。TeXの代替として注目されている。",
        tags: ["Typography"],
        references: ["https://typst.app/"],
    },
    {
        term: "MathML",
        reading: "マスエムエル",
        definition:
            "Mathematical Markup Languageの略。数学的な表現をXML形式で記述するためのマークアップ言語。ウェブ上で数式を表示するための標準規格の一つ。",
        tags: ["Typography", "Web"],
        references: ["https://www.w3.org/Math/"],
    },
    {
        term: "MIDI",
        reading: "ミディ",
        definition:
            "Musical Instrument Digital Interfaceの略。電子楽器やコンピューター間で演奏データなどの音楽情報を通信するための世界共通規格。音声データではなく、ノートオン/オフやベロシティなどの演奏指示を扱う。",
        tags: ["Technology"],
        references: ["https://www.midi.org/"],
    },
    {
        term: "Mutex",
        reading: "ミューテックス",
        definition:
            "Mutual Exclusionの略。マルチスレッドプログラミングにおいて、複数のスレッドが共有リソースに同時にアクセスするのを防ぐための排他制御機構。",
        tags: ["Technology"],
        references: [],
    },
    {
        term: "CMake",
        reading: "シーメイク",
        definition:
            "クロスプラットフォームなビルド自動化ツール。コンパイラに依存しない設定ファイル（例外あり）から、ネイティブのビルド環境（MakefileやNinjaなど）向けのプロジェクトファイルを生成する。",
        tags: ["Technology", "Build System"],
        references: ["https://cmake.org/"],
    },
    {
        term: "Meson",
        reading: "メソン",
        definition:
            "高速で使いやすいことを目指したオープンソースのビルドシステム。Pythonで実装されており、バックエンドとして主にNinjaを使用して高速なビルドを実現する。",
        tags: ["Technology", "Build System"],
        references: ["https://mesonbuild.com/"],
    },
    {
        term: "Ninja",
        reading: "ニンジャ",
        definition:
            "スピードに焦点を当てた小規模なビルドシステム。CMakeやMesonなどのより高レベルなビルドシステムによって生成された入力ファイルを受け取り、実際のビルド処理を高速に実行する。",
        tags: ["Technology", "Build System"],
        references: ["https://ninja-build.org/"],
    },
    {
        term: "Makefile",
        reading: "メイクファイル",
        definition:
            "makeコマンドがソフトウェアをビルドする際に参照する、コンパイルの手順やファイル間の依存関係を記述した設定ファイル。インデントはスペースではなくタブで行う必要があり、注意が必要。",
        tags: ["Technology", "Build System"],
        references: ["https://www.gnu.org/software/make/manual/make.html"],
    },
    {
        term: "robots.txt",
        reading: "ロボットテキスト",
        definition:
            "ウェブクローラーに対して、どのページをクロール可能か、クロール禁止か、クロール頻度などを指示するファイル。",
        tags: ["Crawler", "Web"],
        references: ["https://www.robotstxt.org"],
    },
    {
        term: "llms.txt",
        reading: "エルエルエムエステキスト",
        definition:
            "LLM（大規模言語モデル）向けのサイト情報を提供するファイルフォーマット。AIがウェブサイトのコンテンツを効率的に理解するための仕様。",
        tags: ["Crawler", "Web"],
        references: ["https://llmstxt.org"],
    },
    {
        term: "schema.org",
        reading: "スキーマドットオルグ",
        definition:
            "構造化データの標準化に向けた共同コミュニティ。ウェブページに構造化データを実装するためのスキーマを定義している。",
        tags: ["Crawler", "Web"],
        references: ["https://schema.org"],
    },
    {
        term: "sitemap.xml",
        reading: "サイトマップエックスエムエル",
        definition:
            "XMLフォーマットで記述されたサイトマップ。ウェブクローラーにサイトの構造とすべてのページの存在を効率的に通知するもの。",
        tags: ["Crawler", "Web"],
        references: ["https://www.sitemaps.org"],
    },
    {
        term: ".NET",
        reading: "ドットネット",
        definition:
            "Microsoftが開発したソフトウェアフレームワーク。C#などの言語でアプリケーションを開発するための共通のランタイム環境とライブラリを提供する。",
        tags: ["Technology"],
        references: ["https://dotnet.microsoft.com/"],
    },
    {
        term: "AGENTS.md",
        reading: "エージェンツエムディー",
        definition:
            "AIエージェントが設計や実装に関するガイドラインを参照するドキュメント。AIエージェント用のREADMEのようなもの。",
        tags: ["AI"],
        references: ["https://agents.md/"],
    },
    {
        term: "BudouX",
        reading: "ブドウエックス",
        definition:
            "自然な日本語・中国語・タイ語の改行を実現するためのライブラリ。文章を単語単位で分割し、適切な箇所で改行するようにする。",
        tags: ["Technology"],
        references: ["https://github.com/google/budoux"],
    },
    {
        term: "librosa",
        reading: "リブロサ",
        definition:
            "音声・音楽解析のためのPythonライブラリ。スペクトログラムの生成、テンポ推定、ピッチ検出、ビートトラッキングなどの機能を提供する。",
        tags: ["Technology", "Audio"],
        references: ["https://librosa.org/"],
    },
    {
        term: "Common Package Specification",
        reading: "コモンパッケージスペシフィケーション",
        definition:
            "プログラミング言語やビルドシステムの間で、ライブラリやパッケージのメタデータを共通化して相互運用するための仕様。",
        tags: ["Technology"],
        references: ["https://github.com/cps-org/cps"],
    },
    {
        term: "MathJax",
        reading: "マスジャックス",
        definition:
            "JavaScriptで実装された数式レンダリングライブラリ。TeX記法などで書かれた数式をHTMLやSVGに変換して表示する。このサイトでもビルド時のSVG生成に使用している。",
        tags: ["Typography", "Web"],
        references: ["https://www.mathjax.org/"],
    },
    {
        term: "KaTeX",
        reading: "カテック",
        definition:
            "ウェブ上でTeX記法の数式を高速にレンダリングするJavaScriptライブラリ。表示が速いのが特徴。",
        tags: ["Typography", "Web"],
        references: ["https://katex.org/"],
    },
    {
        term: "SVG",
        reading: "エスブイジー",
        definition:
            "Scalable Vector Graphicsの略。XML形式で記述されるベクター画像フォーマット。拡大しても画質が劣化しないため、アイコンや数式の表示に適している。",
        tags: ["Technology", "Web"],
        references: ["https://www.w3.org/Graphics/SVG/"],
    },
    {
        term: "mise",
        reading: "ミーズ",
        definition:
            "開発ツールのバージョンを一元管理するツール。Node.jsやRubyなど複数言語のランタイムをまとめて管理でき、プロジェクトごとにバージョンを切り替えられる。",
        tags: ["Technology", "Version Manager"],
        references: ["https://mise.jdx.dev/"],
    },
    {
        term: "Node.js",
        reading: "ノードジェイエス",
        definition:
            "JavaScriptをサーバーサイドやローカルで実行するためのランタイム環境。非同期I/Oを得意とし、WebサーバーやCLIツールの開発などに広く用いられる。",
        tags: ["Technology", "Web"],
        references: ["https://nodejs.org/"],
    },
    {
        term: "npm",
        reading: "エヌピーエム",
        definition:
            "Node.jsに標準で付属するパッケージマネージャー。依存ライブラリの管理や、グローバルインストールによるCLIツールの導入などに用いられる。",
        tags: ["Technology", "Package Manager"],
        references: ["https://www.npmjs.com/"],
    },
    {
        term: "pnpm",
        reading: "ピーエヌピーエム",
        definition:
            "Performant npmの略。npmとの互換性を保ちつつ、ハードリンクによるストレージの効率化と動作の高速化を実現したパッケージマネージャー。このサイトの依存関係管理でも使用している。",
        tags: ["Technology", "Package Manager"],
        references: ["https://pnpm.io/"],
    },
    {
        term: "winget",
        reading: "ウィンゲット",
        definition:
            "Windows Package Manager。Microsoftが提供するWindows向けのコマンドラインパッケージマネージャー。アプリケーションの検索・インストール・更新をコマンドラインで行える。",
        tags: ["Technology", "Package Manager"],
        references: [
            "https://learn.microsoft.com/ja-jp/windows/package-manager/winget/",
            "https://github.com/microsoft/winget-cli",
        ],
    },
    {
        term: "PowerShell",
        reading: "パワーシェル",
        definition:
            "Microsoftが開発したシェルおよびスクリプト言語。Windowsに標準搭載されており、.NETを基盤としたオブジェクト指向のパイプラインを特徴とする。PowerShell 7以降(pwsh)ではクロスプラットフォームとなっており、macOSやLinuxでも利用できる。",
        tags: ["Technology", "Language"],
        references: ["https://learn.microsoft.com/ja-jp/powershell/"],
    },
    {
        term: "Lua",
        reading: "ルア",
        definition:
            "ブラジルで開発された軽量なスクリプト言語。C言語との親和性が高く、アプリケーションへの組み込み用途で広く使われている。REAPERのReaScriptでも利用できる。",
        tags: ["Language"],
        references: ["https://www.lua.org/"],
    },
    {
        term: "cURL",
        reading: "カール",
        definition:
            "様々なプロトコルに対応したコマンドラインツール。HTTPリクエストの送信やファイルのダウンロードなどに用いられ、主要なOSでは標準でインストールされていることが多い。",
        tags: ["Technology", "Web"],
        references: ["https://curl.se/"],
    },
    {
        term: "Ruby",
        reading: "ルビー",
        definition:
            "まつもとゆきひろ氏によって開発されたオブジェクト指向のスクリプト言語。読みやすさを重視した文法が特徴で、WebアプリケーションフレームワークのRuby on Railsなどで用いられる。",
        tags: ["Language"],
        references: ["https://www.ruby-lang.org/"],
    },
    {
        term: "REAPER",
        reading: "リーパー",
        definition:
            "Cockos社が開発するクロスプラットフォームなDAW（Digital Audio Workstation）。軽量かつ高速な動作と、スクリプトによる高い拡張性が特徴。",
        tags: ["Technology", "Audio"],
        references: ["https://www.reaper.fm/"],
    },
    {
        term: "ReaScript",
        reading: "リアスクリプト",
        definition:
            "REAPER上で動作するスクリプト環境。EEL2、Lua、Pythonのいずれかで記述でき、REAPERの操作の自動化や機能拡張を行える。",
        tags: ["Technology", "Audio"],
        references: ["https://www.reaper.fm/sdk/reascript/reascript.php"],
    },
];

// 用語をアルファベット順・五十音順などにソート
const sortedWords = words.sort((a, b) => a.term.localeCompare(b.term, "ja"));

// 頭文字を取得する関数
const getInitialChar = (word: any) => {
    const char = word.term.charAt(0);
    if (/[A-Za-z0-9]/.test(char)) return char.toUpperCase();
    return char;
};

// 頭文字ごとにグループ化
const groupedWords = sortedWords.reduce(
    (acc, word) => {
        const init = getInitialChar(word);
        if (!acc[init]) acc[init] = [];
        acc[init].push(word);
        return acc;
    },
    {} as Record<string, typeof words>,
);

const sortedInitials = Object.keys(groupedWords).sort((a, b) => {
    // アルファベットと数字を先に、それ以外を後にする
    const aIsAlpha = /^[A-Z0-9]$/.test(a);
    const bIsAlpha = /^[A-Z0-9]$/.test(b);
    if (aIsAlpha && bIsAlpha) return a.localeCompare(b);
    if (aIsAlpha) return -1;
    if (bIsAlpha) return 1;
    return a.localeCompare(b);
});
---

<PostLayout
    title="Glossary"
    description="Glossary of terms used in this site"
    pubDate={new Date("2026-06-10")}
>
    <div>
        <p>
            このページでは、私が使用する用語をまとめています。備忘録です。
            用語の意味を簡潔に説明しており、筆者の主観を含んでいるため、すべての説明が厳密に正確とは限りません。
        </p>
    </div>
    <div class="index-nav-container">
        <div class="index-group">
            {
                sortedInitials.map((initial) => (
                    <a href={`#index-${initial}`}>{initial}</a>
                ))
            }
        </div>
    </div>
    <div class="dictionary">
        {
            sortedInitials.map((initial) => (
                <div class="index-section">
                    <h2 id={`index-${initial}`} class="index-header">
                        {initial}
                    </h2>
                    <div class="word-list">
                        {groupedWords[initial].map((word) => (
                            <div class="word-card">
                                <h3 class="term">
                                    {word.term}{" "}
                                    <span class="reading">{word.reading}</span>
                                </h3>
                                {word.tags && word.tags.length > 0 && (
                                    <div class="tags">
                                        {word.tags.map((tag) => (
                                            <span class="tag">#{tag}</span>
                                        ))}
                                    </div>
                                )}
                                <p class="definition budoux-data">
                                    {parser
                                        .parse(word.definition)
                                        .map((value, index) => (
                                            <>
                                                {index > 0 && <wbr />}
                                                {value}
                                            </>
                                        ))}
                                </p>
                                {word.references &&
                                    word.references.length > 0 && (
                                        <div class="references">
                                            <div class="references-label">
                                                References:
                                            </div>
                                            {word.references.map((ref) => (
                                                <a
                                                    href={ref}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="reference-link"
                                                >
                                                    {ref}
                                                </a>
                                            ))}
                                        </div>
                                    )}
                            </div>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</PostLayout>

<style>
    .index-nav-container {
        margin-bottom: 3rem;
    }
    .index-group {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(3.5rem, 1fr));
        gap: 0.8rem;
    }
    .index-group a {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 3.5rem;
        background: transparent;
        border: 2px solid rgba(128, 128, 128, 0.2);
        border-radius: 12px;
        text-decoration: none;
        color: rgb(var(--text-primary));
        font-weight: bold;
        font-size: 1.1rem;
        transition: all 0.2s ease;
    }
    .index-group a:hover {
        background: rgb(var(--accent));
        color: #fff;
        border-color: rgb(var(--accent));
    }
    .index-section {
        margin-bottom: 3rem;
    }
    .index-header {
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid rgba(128, 128, 128, 0.2);
        color: rgb(var(--accent));
    }
    .word-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .word-card {
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px solid rgba(128, 128, 128, 0.2);
        transition: border-color 0.15s ease;
    }
    .word-card:hover {
        border-color: rgb(var(--accent));
    }
    .term {
        margin: 0;
        color: rgb(var(--text-primary));
        display: flex;
        align-items: baseline;
        gap: 0.8rem;
    }
    .reading {
        font-size: 0.9rem;
        font-weight: normal;
        color: rgb(var(--text-secondary));
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }
    .tag {
        display: inline-block;
        font-size: 0.8rem;
        color: rgb(var(--accent));
        font-weight: bold;
    }
    .definition {
        margin: 1rem 0 0 0;
        line-height: 1.6;
    }
    .budoux-data {
        word-break: keep-all;
        overflow-wrap: anywhere;
    }
    .references {
        margin-top: 0.8rem;
        padding-top: 0.8rem;
        border-top: 1px solid rgba(128, 128, 128, 0.1);
        font-size: 0.9rem;
    }
    .references-label {
        color: rgb(var(--text-secondary));
        font-weight: bold;
        margin-bottom: 0.3rem;
    }
    .reference-link {
        display: inline-block;
        margin-right: 0.8rem;
        margin-bottom: 0.3rem;
        padding: 0.3rem 0.6rem;
        background: rgba(var(--accent-rgb), 0.1);
        color: rgb(var(--accent));
        text-decoration: none;
        border-radius: 4px;
        transition: all 0.2s ease;
    }
    .reference-link:hover {
        background: rgba(var(--accent-rgb), 0.2);
        text-decoration: underline;
    }
</style>
